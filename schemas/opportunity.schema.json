{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opportunity.schema.json",
  "title": "Opportunity",
  "description": "A Programme offered for a particular intake, campus and teaching language. This is the smallest thing a student can actually assess or save, and the unit the whole product is built around.",
  "type": "object",
  "required": ["id", "programme", "institution", "destination", "intake", "language", "meta"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "programme": { "$ref": "common.schema.json#/$defs/id" },
    "institution": { "$ref": "common.schema.json#/$defs/id" },
    "destination": { "$ref": "common.schema.json#/$defs/id" },
    "place": { "$ref": "common.schema.json#/$defs/id" },
    "intake": { "$ref": "common.schema.json#/$defs/intake" },
    "startMonth": { "type": "string" },
    "language": {
      "type": "object",
      "required": ["instruction"],
      "properties": {
        "instruction": { "type": "string", "description": "The language the Programme is actually taught in." },
        "fullyInLanguage": { "type": "boolean", "description": "False where only part of the degree is in this language — a common and consequential trap." },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },

    "admission": {
      "type": "object",
      "properties": {
        "restricted": {
          "type": "boolean",
          "description": "True where meeting the requirements does not guarantee a place."
        },
        "capacityNote": { "type": "string" },
        "selection": {
          "type": "array",
          "description": "How eligible applicants are ranked. Kept computationally separate from eligibility — a cut-off is not a requirement.",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["gpa", "subject-grades", "essay", "interview", "portfolio", "audition", "test", "work-experience", "lottery", "other"] },
              "description": { "type": "string" },
              "weight": { "type": "string" },
              "evidence": { "$ref": "common.schema.json#/$defs/evidenceRefs" }
            },
            "additionalProperties": false
          }
        },
        "historicalCutoffs": {
          "type": "array",
          "description": "Past cut-offs are context for how competitive something has been. They are never treated as a requirement and never used to predict an offer.",
          "items": {
            "type": "object",
            "required": ["intake", "value"],
            "properties": {
              "intake": { "$ref": "common.schema.json#/$defs/intake" },
              "quota": { "type": "string" },
              "value": { "type": "string" },
              "scale": { "type": "string" },
              "evidence": { "$ref": "common.schema.json#/$defs/evidenceRefs" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "requirements": {
      "type": "array",
      "description": "Machine-readable rules paired with the source's own wording.",
      "items": { "$ref": "#/$defs/requirement" }
    },

    "officialRequirementsText": {
      "type": "array",
      "description": "The requirement paragraph as published, kept verbatim so a counsellor can audit our normalisation.",
      "items": { "$ref": "common.schema.json#/$defs/localisedText" }
    },

    "cost": {
      "type": "array",
      "description": "One entry per applicant group, because the same Opportunity costs different people very different amounts.",
      "items": {
        "type": "object",
        "required": ["applicantGroup", "feeStatus"],
        "properties": {
          "applicantGroup": { "$ref": "common.schema.json#/$defs/applicantGroup" },
          "feeStatus": { "$ref": "common.schema.json#/$defs/feeStatus" },
          "tuition": { "$ref": "common.schema.json#/$defs/money" },
          "mandatoryFees": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "amount"],
              "properties": {
                "label": { "type": "string" },
                "amount": { "$ref": "common.schema.json#/$defs/money" }
              },
              "additionalProperties": false
            }
          },
          "priceYear": { "type": "string", "description": "The academic year the figure was published for. Required honesty: never present an old figure as current." },
          "evidence": { "$ref": "common.schema.json#/$defs/evidenceRefs" }
        },
        "additionalProperties": false
      }
    },

    "applicationRoutes": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/id" }
    },

    "outcomePathway": {
      "type": "object",
      "properties": {
        "accreditation": { "type": "string" },
        "professionalRecognition": { "type": "string" },
        "furtherStudy": { "type": "string" },
        "workRoutes": { "type": "string" },
        "evidence": { "$ref": "common.schema.json#/$defs/evidenceRefs" }
      },
      "additionalProperties": false
    },

    "evidence": { "$ref": "common.schema.json#/$defs/evidenceRefs" },
    "meta": { "$ref": "common.schema.json#/$defs/recordMeta" }
  },
  "additionalProperties": false,

  "$defs": {
    "requirement": {
      "type": "object",
      "required": ["id", "kind", "mandatory"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "kind": {
          "enum": [
            "ib-diploma", "ib-total-points", "ib-subject", "subject-combination",
            "local-equivalency", "language-general", "language-programme",
            "test", "portfolio", "audition", "interview", "essay", "reference", "work-sample",
            "activity", "citizenship", "residency", "age", "prior-education",
            "application-round", "quota", "other"
          ]
        },
        "mandatory": {
          "type": "boolean",
          "description": "False marks a Selection Factor — used in ranking, not in eligibility."
        },
        "label": { "type": "string", "description": "Student-readable, e.g. 'Mathematics at A level'." },
        "officialWording": { "$ref": "common.schema.json#/$defs/localisedText" },

        "subject": { "type": "string" },
        "level": { "$ref": "common.schema.json#/$defs/danishLevel" },
        "minGrade": { "type": "number", "description": "On the destination's own scale." },
        "gradeScale": { "type": "string" },
        "minPoints": { "type": "integer", "minimum": 0, "maximum": 45 },

        "operator": {
          "enum": ["all-of", "one-of", "at-least", "at-most", "equals", "exists"],
          "description": "How to evaluate `alternatives` or the threshold."
        },
        "alternatives": {
          "type": "array",
          "description": "Each element is a set of requirements; satisfying any one set satisfies the rule.",
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/requirement" }
          }
        },

        "applicability": {
          "type": "object",
          "description": "Who and when the rule binds. Without this a rule is not safely usable.",
          "properties": {
            "intake": { "$ref": "common.schema.json#/$defs/intake" },
            "applicantGroup": { "$ref": "common.schema.json#/$defs/applicantGroup" },
            "feeStatus": { "$ref": "common.schema.json#/$defs/feeStatus" },
            "qualificationVersion": { "type": "string" },
            "exception": { "type": "string" }
          },
          "additionalProperties": false
        },

        "satisfiedBy": {
          "type": "array",
          "description": "Named alternative ways to meet it — a language test in place of a subject, for instance.",
          "items": { "type": "string" }
        },
        "preparationActions": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/id" },
          "description": "What a student could still do about this gap."
        },
        "note": { "type": "string" },
        "evidence": { "$ref": "common.schema.json#/$defs/evidenceRefs" }
      },
      "additionalProperties": false
    }
  }
}
