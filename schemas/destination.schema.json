{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "destination.schema.json",
  "title": "Destination",
  "description": "A country or admissions jurisdiction whose rules, costs and application process apply to the Opportunities inside it.",
  "type": "object",
  "required": [
    "id",
    "name",
    "scope",
    "meta"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id",
      "description": "ISO 3166-1 alpha-2, lowercase, plus a jurisdiction suffix where one country has several (e.g. be-fl)."
    },
    "iso2": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "name": {
      "type": "string"
    },
    "adjective": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "europe",
        "worldwide"
      ]
    },
    "region": {
      "type": "string"
    },
    "capital": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "membership": {
      "type": "object",
      "properties": {
        "eu": {
          "type": "boolean"
        },
        "eea": {
          "type": "boolean"
        },
        "nordic": {
          "type": "boolean"
        },
        "schengen": {
          "type": "boolean"
        },
        "efta": {
          "type": "boolean",
          "description": "Member of EFTA. Switzerland is in neither the EU nor the EEA, but its citizens are in this site's default readership (EU, EEA or Swiss)."
        }
      },
      "additionalProperties": false
    },
    "artDirection": {
      "type": "object",
      "description": "Visual variety only. Nothing here can reorder, hide or re-rank information — a destination may look different, but the same question is answered in the same place on every page.",
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accentDark": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "pattern": {
          "enum": [
            "none",
            "latitude",
            "grid",
            "wave"
          ]
        },
        "focal": {
          "type": "string",
          "pattern": "^[0-9]{1,3}% [0-9]{1,3}%$"
        }
      },
      "additionalProperties": false
    },
    "tagline": {
      "type": "string",
      "maxLength": 90
    },
    "ownCitizens": {
      "type": "string",
      "minLength": 40,
      "maxLength": 700,
      "description": "What is different on this page for a reader who holds this Destination's citizenship, even if the answer is 'very little'. Most of the page is written for an EU/EEA citizen from somewhere else; some of this school's students are citizens of the country they are reading about. Begins 'If you hold <adjective> citizenship'. Required for every EU/EEA/EFTA Destination by scripts/test-audience.mjs."
    },
    "summary": {
      "type": "string"
    },
    "whyConsider": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "watchOuts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ibRecognition": {
      "type": "object",
      "description": "How the national system reads an IB Diploma. Programme-level rules live on the Opportunity, not here.",
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "minimumPoints": {
          "type": "string"
        },
        "subjectLevelRule": {
          "type": "string"
        },
        "gradeConversion": {
          "type": "string"
        },
        "conversionTable": {
          "type": "array",
          "description": "Where the destination publishes an explicit IB-to-local mapping.",
          "items": {
            "type": "object",
            "required": [
              "ib",
              "local"
            ],
            "properties": {
              "ib": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "local": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "conversionScale": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "$ref": "common.schema.json#/$defs/evidenceRefs"
        }
      },
      "additionalProperties": false
    },
    "language": {
      "type": "object",
      "properties": {
        "englishTaughtBachelors": {
          "type": "string"
        },
        "englishProof": {
          "type": "string"
        },
        "localLanguageRequired": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "livingContext": {
      "type": "object",
      "properties": {
        "livingCostMonthly": {
          "$ref": "common.schema.json#/$defs/money"
        },
        "livingCostYear": {
          "type": "string"
        },
        "housing": {
          "type": "string"
        },
        "healthcare": {
          "type": "string"
        },
        "workRights": {
          "type": "string"
        },
        "residency": {
          "type": "string"
        },
        "funding": {
          "type": "array",
          "description": "Funding lines. A line about a scheme recorded in data/funding/ is written as a reference, so the scheme's condition of who can claim it is stated once (docs/research/audience).",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["fund"],
                "properties": {
                  "fund": { "type": "string", "pattern": "^fund-[a-z0-9]+(-[a-z0-9]+)*$", "description": "The id of a record in data/funding/." },
                  "note": { "type": "string", "maxLength": 400, "description": "Only what is particular to this Destination." }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "evidence": {
          "$ref": "common.schema.json#/$defs/evidenceRefs"
        }
      },
      "additionalProperties": false
    },
    "feeContext": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "applicantGroup"
        ],
        "properties": {
          "applicantGroup": {
            "$ref": "common.schema.json#/$defs/applicantGroup"
          },
          "feeStatus": {
            "$ref": "common.schema.json#/$defs/feeStatus"
          },
          "summary": {
            "type": "string"
          },
          "typicalRange": {
            "type": "string"
          },
          "priceYear": {
            "type": "string"
          },
          "evidence": {
            "$ref": "common.schema.json#/$defs/evidenceRefs"
          }
        },
        "additionalProperties": false
      }
    },
    "applicationSystems": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "targetIntake": {
      "$ref": "common.schema.json#/$defs/intake"
    },
    "evidence": {
      "$ref": "common.schema.json#/$defs/evidenceRefs"
    },
    "meta": {
      "$ref": "common.schema.json#/$defs/recordMeta"
    },
    "sectorLandscape": {
      "type": "object",
      "description": "How this country’s post-secondary system is actually organised, in its own vocabulary. Needed because the category names do not translate: telling a Danish student about \"colleges\", or a French student about \"professional bachelors\", describes nothing they can recognise. Also the only place the non-university routes get named, and most IB students are never told those exist.",
      "required": [
        "summary",
        "routes"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 60,
          "maxLength": 1200,
          "description": "How the system divides up, in two or three sentences, using the local names."
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "description": "The kinds of institution, each under its own local name.",
          "items": {
            "type": "object",
            "required": [
              "localName",
              "what"
            ],
            "properties": {
              "localName": {
                "type": "string",
                "description": "What it is called there: universitet, Fachhochschule, grande école."
              },
              "englishName": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "research",
                  "applied",
                  "specialist",
                  "professional",
                  "college"
                ]
              },
              "what": {
                "type": "string",
                "minLength": 30,
                "maxLength": 900,
                "description": "What studying there is actually like, and who it suits."
              },
              "ibAccessible": {
                "enum": [
                  "yes",
                  "partly",
                  "rarely",
                  "unknown"
                ],
                "description": "Whether an IB diploma opens this route, which is a different question from whether the route exists."
              },
              "englishTaught": {
                "enum": [
                  "common",
                  "some",
                  "rare",
                  "none",
                  "unknown"
                ]
              },
              "note": {
                "type": "string",
                "maxLength": 600
              }
            },
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/evidenceRef"
          }
        }
      },
      "additionalProperties": false
    },
    "institutionGrouping": {
      "enum": [
        "none",
        "jurisdiction",
        "sector",
        "city"
      ],
      "description": "How this Destination’s institutions divide for the purpose of applying. Declared rather than inferred: an undeclared Destination renders as one unit, which is right for a centralised system and is also what a Destination nobody has examined yet looks like — src/lib/jurisdictions.mjs keeps those two apart."
    },
    "jurisdictions": {
      "type": "array",
      "description": "The Application Jurisdictions inside this Destination — the administrative areas whose shared admissions rules or services apply. Needed wherever the country is not the unit that decides how you apply: a student picking Toronto and a student picking Vancouver are on two different paths with different dates.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string",
            "description": "As the student will meet it: Ontario, Bavaria, Scotland."
          },
          "kind": {
            "enum": [
              "province",
              "state",
              "territory",
              "region",
              "canton",
              "nation",
              "sector",
              "authority"
            ]
          },
          "summary": {
            "type": "string",
            "maxLength": 600
          },
          "applicationRoute": {
            "$ref": "common.schema.json#/$defs/id",
            "description": "The Application Route these institutions apply through. Omit where none is recorded — that is a different thing from applying directly, which is itself a route."
          },
          "variations": {
            "type": "array",
            "description": "What differs here from the rest of the Destination, structured rather than buried in a note. Cost, health cover and deadlines are the three that actually vary by jurisdiction and the three a reader currently has to disentangle from prose.",
            "items": {
              "type": "object",
              "required": [
                "field",
                "summary"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "description": "What varies: costs, healthcare, deadlines, workRights."
                },
                "label": {
                  "type": "string"
                },
                "summary": {
                  "type": "string",
                  "maxLength": 600
                },
                "source": {
                  "$ref": "common.schema.json#/$defs/url"
                },
                "evidence": {
                  "$ref": "common.schema.json#/$defs/evidenceRefs"
                }
              },
              "additionalProperties": false
            }
          },
          "evidence": {
            "$ref": "common.schema.json#/$defs/evidenceRefs"
          }
        },
        "additionalProperties": false
      }
    },
    "articleName": {
      "type": "string",
      "description": "The name as it reads inside a sentence, where English takes a definite article: \"the Netherlands\", \"the United Kingdom\". A property of the name rather than of the country, so it belongs on the record — a page that composes a list of destinations cannot know which ones need one."
    }
  },
  "additionalProperties": false
}
