{
  "name": "ib-post-secondary-opportunities",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A guide to English-taught post-secondary opportunities for IB Diploma students.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "dev": "node scripts/serve.mjs --watch",
    "validate": "node scripts/validate.mjs",
    "check": "node scripts/check.mjs",
    "check:links": "node scripts/check.mjs --external",
    "migrate:dk": "node scripts/migrate-denmark.mjs",
    "freshness": "node scripts/freshness.mjs",
    "rollover": "node scripts/freshness.mjs --rollover",
    "watch:sources": "node scripts/watch-sources.mjs",
    "icons": "node scripts/make-icons.mjs",
    "geocode": "node scripts/geocode.mjs",
    "images": "node scripts/fetch-images.mjs",
    "images:official": "node scripts/fetch-official-images.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "test:eligibility": "node scripts/test-eligibility.mjs",
    "test": "node scripts/validate.mjs && node scripts/test-eligibility.mjs && node scripts/test-probes.mjs && node scripts/test-sourcing.mjs && node src/build.mjs && node scripts/check.mjs",
    "release-check": "node scripts/release-check.mjs",
    "test:probes": "node scripts/test-probes.mjs",
    "verify": "node scripts/verify-evidence.mjs",
    "verify:write": "node scripts/verify-evidence.mjs --write",
    "test:sourcing": "node scripts/test-sourcing.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.4"
  }
}
